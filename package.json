{
  "name": "memoivy",
  "private": true,
  "scripts": {
    "brief": "ltm ui",
    "dev": "node tools/desktop-dev.cjs",
    "dev:web": "vite",
    "build:web": "vite build",
    "build:engine": "cargo build --manifest-path engine/Cargo.toml --release --locked",
    "build": "npm run build:web && npm run build:engine",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open",
    "build:storybook": "storybook build",
    "desktop:dev": "electron .",
    "desktop:build": "npm run build && electron-builder --config desktop/electron-builder.yml",
    "desktop:dir": "npm run build && electron-builder --dir --config desktop/electron-builder.yml"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.6.7",
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "listenee-ltm": "0.1.0",
    "storybook": "10.6.7",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "markdown-it": "15.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "version": "0.1.2",
  "description": "MemoIvy desktop notes",
  "main": "desktop/main.cjs",
  "license": "MIT",
  "type": "module"
}
