{
  "name": "memoivy",
  "private": true,
  "scripts": {
    "brief": "ltm ui",
    "dev": "node tools/desktop-dev.cjs",
    "dev:web": "vite",
    "build:web": "vite build",
    "build:engine": "cargo build --manifest-path engine/Cargo.toml --release --locked",
    "build": "npm run build:web && npm run build:engine",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open",
    "build:storybook": "storybook build",
    "desktop:dev": "electron .",
    "desktop:build": "npm run build && electron-builder --config desktop/electron-builder.yml",
    "desktop:dir": "npm run build && electron-builder --dir --config desktop/electron-builder.yml",
    "test:unit": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "test:stories": "node scripts/test-stories.mjs",
    "test:perf": "node scripts/test-perf.mjs",
    "test:memory": "node scripts/test-memory.mjs",
    "test:stories:live": "test-storybook --url http://127.0.0.1:6006",
    "lint": "biome lint .",
    "check:unused": "knip",
    "check:deps": "depcruise frontend desktop --config .dependency-cruiser.cjs",
    "check:dupes": "jscpd",
    "release:windows": "npm run build && electron-builder --win nsis --x64 --publish never --config desktop/electron-builder.yml",
    "release:snap": "npm run build && electron-builder --linux --x64 --dir --publish never --config desktop/electron-builder.yml && node scripts/package-snap.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@storybook/react-vite": "10.6.7",
    "@storybook/test-runner": "0.26.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "axe-playwright": "2.2.2",
    "dependency-cruiser": "18.8.0",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "jscpd": "5.4.3",
    "knip": "6.45.1",
    "listenee-ltm": "0.1.0",
    "playwright": "1.65.1",
    "storybook": "10.6.7",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "version": "0.1.7",
  "description": "MemoIvy desktop notes",
  "main": "desktop/main.cjs",
  "license": "MIT",
  "type": "module"
}
